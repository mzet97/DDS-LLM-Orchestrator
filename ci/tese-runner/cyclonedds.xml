<?xml version="1.0" encoding="UTF-8"?>
<!-- Config CycloneDDS do runner tese (jobs de CI).
     Configuração EFETIVA: interface de rede selecionada automaticamente
     (autodetermine) e multicast em "default" — padroniza a descoberta
     entre participants DDS do mesmo namespace de rede do job.
     Este arquivo NÃO corrige a falha histórica do teste de claim (a
     causa raiz — arbitragem por GUID por ausência de ownership_strength
     no tópico ToolCall.Request, que tem chave call_id — foi corrigida
     no código em 9321e31) e NÃO é garantia de isolamento de rede:
     jobs alcançam os endpoints do cluster necessários à CI (Gitea,
     registry). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true"/>
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
