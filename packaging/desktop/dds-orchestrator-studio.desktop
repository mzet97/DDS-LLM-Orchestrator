[Desktop Entry]
Version=1.0
Type=Application
Name=DDS Orchestrator Studio
Comment=Administração do enxame DDS-LLM (nó, catálogo, inferência, agentes, topologia)
# Instalação: .deb via scripts/build-studio-deb.sh (instala /usr/bin/studio);
# alternativa manual: cp target/release/studio ~/.local/bin/.
Exec=studio
Icon=computer
Terminal=false
Categories=Development;
StartupWMClass=studio
